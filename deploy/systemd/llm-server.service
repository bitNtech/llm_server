# /etc/systemd/system/llm-server.service
# Install: see docs/DEPLOYMENT.md ("Run as a service").
[Unit]
Description=LLM inference server (vLLM engine + FastAPI gateway)
Wants=network-online.target
After=network-online.target nvidia-persistenced.service

[Service]
Type=simple
User=llm
Group=llm
WorkingDirectory=/opt/llm-server
Environment=APP_ENV=production
Environment=HOME=/var/lib/llm-server
Environment=HF_HOME=/opt/models/huggingface
# Secrets + overrides (template: deploy/production.env.example); everything else uses built-in defaults.
Environment=ENV_FILE=/etc/llm-server/llm-server.env
# run.sh validates, installs on first boot (or after an upgrade), then supervises both processes.
ExecStart=/opt/llm-server/run.sh start
# SIGTERM -> run.sh drains the gateway (SHUTDOWN_GRACE_S) and then stops vLLM.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=3600
TimeoutStopSec=120
Restart=on-failure
RestartSec=10
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/llm-server /var/lib/llm-server /opt/models
ReadOnlyPaths=/etc/llm-server

StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-server

[Install]
WantedBy=multi-user.target
