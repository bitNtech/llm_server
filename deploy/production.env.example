# Production overrides for EC2. Install as /etc/llm-server/llm-server.env (owner llm, mode 600);
# the systemd unit passes it to run.sh via ENV_FILE. Every setting not listed here uses the
# built-in defaults, which are the latency-tuned Gemma 4 26B-A4B profile documented in .env.example.

APP_ENV=production
API_KEYS=CHANGE_ME_1,CHANGE_ME_2          # python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HF_TOKEN=                                 # optional for these public repos; avoids Hub rate limits
HF_HOME=/opt/models/huggingface           # large volume for ~30 GB of weights

# Behind nginx on the same host keep 127.0.0.1; behind an ALB use its subnet CIDR (or "*" in a private subnet).
FORWARDED_ALLOW_IPS=127.0.0.1
METRICS_REQUIRE_AUTH=false                # true if :8000/metrics is reachable from outside the VPC
# RATE_LIMIT_PER_MINUTE=600
# CORS_ALLOW_ORIGINS=https://app.example.com

# Model + latency profile (defaults shown; change deliberately and benchmark with scripts/bench.py)
ENGINE_MODEL=RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic
ENGINE_REVISION=ed35d7abe5d940da41b4ff06eb482feb0be8cb44
ENGINE_SPECULATIVE_CONFIG='{"model": "google/gemma-4-26B-A4B-it-assistant", "revision": "6e5aaaf4c42b98394530b8fda2e95cadd65c151c", "num_speculative_tokens": 4}'
ENGINE_MAX_MODEL_LEN=8192
ENGINE_MAX_NUM_SEQS=32
MAX_CONCURRENT_GENERATIONS=32
DEFAULT_MAX_TOKENS=200
# DEFAULT_SYSTEM_PROMPT_FILE=prompts/agent.txt
