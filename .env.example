# =============================================================================
# LLM inference server configuration. Copy to .env (run.sh does this on first
# start in development). Real environment variables override this file.
# Values with spaces or JSON must be quoted: KEY='{"a": 1}'.
# =============================================================================

# ----------------------------------------------------------------- server
APP_ENV=development                # development | production (production: auth required, JSON logs, no /docs)
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=auto                    # auto (json in production, text in development) | json | text
ACCESS_LOG=false                   # structured log line per HTTP request
# DOCS_ENABLED=                    # /docs + /openapi.json; default: on in development, off in production
SHUTDOWN_GRACE_S=20                # in-flight responses get this long to finish on SIGTERM
FORWARDED_ALLOW_IPS=127.0.0.1      # proxies trusted for X-Forwarded-For ("*" behind an AWS ALB in a private subnet)

# --------------------------------------------------------------- security
API_KEYS=                          # comma-separated; clients send "Authorization: Bearer <key>" or X-API-Key
ALLOW_UNAUTHENTICATED=false        # production refuses to start without API_KEYS unless true
METRICS_REQUIRE_AUTH=false         # protect /metrics with API keys
CORS_ALLOW_ORIGINS=                # comma-separated origins for browser clients ("*" only in development)
RATE_LIMIT_PER_MINUTE=0            # per API key (or client IP without auth); 0 = off
MAX_REQUEST_BODY_BYTES=1048576

# ------------------------------------------------------ engine connection
ENGINE_MODE=managed                # managed: run.sh starts vLLM | external: use ENGINE_BASE_URL | mock: fake engine
ENGINE_HOST=127.0.0.1              # vLLM binds here (keep loopback: only the gateway talks to it)
ENGINE_PORT=8001
ENGINE_BASE_URL=                   # external mode, e.g. http://10.0.1.20:8001
ENGINE_API_KEY=                    # empty: run.sh generates a random key per start (managed/mock)
ENGINE_CONNECT_TIMEOUT_S=5
ENGINE_FIRST_TOKEN_TIMEOUT_S=15    # queue + prefill budget before giving up on a request
ENGINE_STREAM_IDLE_TIMEOUT_S=10    # max silence between streamed tokens
ENGINE_HEALTH_INTERVAL_S=5
ENGINE_STARTUP_TIMEOUT_S=1800      # model download + load + compile/CUDA-graph capture
ENGINE_WARMUP=true                 # warm JIT/CUDA-graph/drafter paths before /health/ready turns 200
ENGINE_WARMUP_TIMEOUT_S=900
GENERATION_TIMEOUT_S=120           # hard cap per response (all tool rounds included)

# ------------------------------------------------------------------ model
# Gemma 4 26B-A4B (MoE: 128 experts, 8 active -> ~4B active params per token), tuned for latency.
# FP8 W8A8 checkpoint (RedHat/Neural Magic, data-free FP8_DYNAMIC): ~29 GB instead of ~52 GB, 99-103%
# accuracy recovery incl. tool calling (BFCLv4), and ~half the bytes read per decoded token, which is
# what bounds decode speed. Do NOT use 4-bit (AWQ/W4A16/NVFP4) builds of this model: its small expert
# width (704) loses noticeable quality at 4 bits (vLLM recipe).
ENGINE_MODEL=RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic
ENGINE_REVISION=ed35d7abe5d940da41b4ff06eb482feb0be8cb44   # pinned commit (2026-08-13); bump deliberately
ENGINE_SERVED_MODEL_NAME=gemma-4-26b-a4b-it   # name clients may send ("default" always works too)
ENGINE_TOKENIZER=
ENGINE_TRUST_REMOTE_CODE=false
ENGINE_MODEL_PREFETCH=true         # download model + drafter before starting vLLM, then check they fit in memory
ENGINE_DOWNLOAD_DIR=               # default: $HF_HOME (~/.cache/huggingface)
HF_TOKEN=                          # optional (both repos are public); avoids Hub rate limits
# HF_HOME=/opt/models/huggingface  # put the cache on a large volume (EC2: NVMe instance store or EBS)

# Gemma 4 native parsers (vLLM >= 0.30 handles the bare/malformed tool-call openers this model emits).
ENGINE_ENABLE_AUTO_TOOL_CHOICE=true
ENGINE_TOOL_CALL_PARSER=gemma4
ENGINE_REASONING_PARSER=gemma4     # thinking stays OFF (see DEFAULT_CHAT_TEMPLATE_KWARGS); parser only strips it if enabled
ENGINE_LANGUAGE_MODEL_ONLY=true    # skip the vision tower: more KV cache, no multimodal profiling at startup
ENGINE_CHAT_TEMPLATE=              # the checkpoint's own template supports tools + thinking; no override needed
ENGINE_GENERATION_CONFIG=auto      # Google's sampling defaults (temperature 1.0, top_p 0.95, top_k 64)

# Speculative decoding with Gemma 4's MTP "assistant" drafter (0.4B, shares the target's KV cache).
# It drafts 4 tokens per step that the target verifies in one pass: ~2-3x faster decode at low and
# moderate concurrency, identical output distribution. vLLM keeps async scheduling on with MTP.
# Lower temperatures raise the acceptance rate. Empty = off. Ignored on the CPU engine.
ENGINE_SPECULATIVE_CONFIG='{"model": "google/gemma-4-26B-A4B-it-assistant", "revision": "6e5aaaf4c42b98394530b8fda2e95cadd65c151c", "num_speculative_tokens": 4}'

# --------------------------------------------------------- engine hardware
ENGINE_DEVICE=auto                 # auto (CUDA if an NVIDIA GPU is visible, else CPU) | cuda | cpu
ENGINE_DTYPE=auto                  # FP8 checkpoint: activations/non-quantized layers in bf16
ENGINE_QUANTIZATION=               # read from the checkpoint (compressed-tensors FP8)
ENGINE_MAX_MODEL_LEN=8192          # voice calls: 8k is plenty; shorter context = faster decode attention
ENGINE_GPU_MEMORY_UTILIZATION=0.90 # share of GPU memory vLLM may use (weights + activations + KV cache)
ENGINE_KV_CACHE_MEMORY_GIB=0       # 0 = from utilization
ENGINE_KV_CACHE_DTYPE=auto         # bf16 KV: Gemma 4 is mostly sliding-window (1024) so KV is small anyway
ENGINE_TENSOR_PARALLEL_SIZE=1      # one 48-80 GB GPU is fastest; "auto" only if the model does not fit one GPU
ENGINE_MAX_NUM_SEQS=32             # cap the batch: small batches keep inter-token latency low (raise for throughput)
ENGINE_MAX_NUM_BATCHED_TOKENS=0    # 0 = vLLM default chunked-prefill budget
ENGINE_ENABLE_PREFIX_CACHING=true  # system prompt + history KV reused across turns: TTFT ~ new tokens only
ENGINE_ENFORCE_EAGER=false         # keep CUDA graphs (they matter a lot for decode latency)
ENGINE_ATTENTION_BACKEND=auto      # auto: TRITON_ATTN on H100/H200 with vLLM 0.30/0.31 (FA4 decode regression vllm#59362)
ENGINE_SCHEDULING_POLICY=fcfs      # fcfs | priority (live turns before background summaries)
ENGINE_CPU_RESERVED_CORES=1        # CPU engine only
ENGINE_LOG_REQUESTS=false
ENGINE_EXTRA_ARGS=                 # anything else for `vllm serve`
# CUDA_VISIBLE_DEVICES=0           # restrict the GPUs vLLM sees

# ------------------------------------------------------------ installation
ENGINE_VLLM_VERSION=0.31.0         # pinned vLLM release
ENGINE_CUDA_VARIANT=auto           # auto (driver >= 580 -> cu130, else cu129) | cu130 | cu129
ENGINE_INSTALL_SPEC=               # override the install entirely (pip spec, wheel URL or path)

# ------------------------------------------------------- inference defaults
DEFAULT_SYSTEM_PROMPT=             # used for sessions created without a system_prompt
DEFAULT_SYSTEM_PROMPT_FILE=        # or load it from a file (relative to the project root)
DEFAULT_MAX_TOKENS=200             # voice replies are short; keeps worst-case latency bounded
MAX_TOKENS_LIMIT=4096              # requests asking for more are rejected
DEFAULT_TEMPERATURE=               # empty = model default (generation_config.json)
DEFAULT_TOP_P=
DEFAULT_TOP_K=
DEFAULT_MIN_P=
DEFAULT_REPETITION_PENALTY=
DEFAULT_PRESENCE_PENALTY=
DEFAULT_FREQUENCY_PENALTY=
DEFAULT_STOP=                      # comma-separated stop strings
DEFAULT_CHAT_TEMPLATE_KWARGS='{"enable_thinking": false}'   # no hidden reasoning before speaking
MAX_INPUT_CHARS=32000              # per message

# -------------------------------------------------------------- concurrency
MAX_CONCURRENT_GENERATIONS=32      # = ENGINE_MAX_NUM_SEQS; beyond this callers queue (then 429) instead of slowing everyone
MAX_QUEUED_GENERATIONS=256         # waiting beyond this -> 429 immediately
QUEUE_TIMEOUT_S=3                  # a caller waiting longer than this gets a 429 (play a fallback line) instead

# ------------------------------------------------------- sessions / context
SESSION_TTL_S=1800                 # idle sessions (no WebSocket attached) expire after this
MAX_SESSIONS=10000
MAX_MESSAGES_PER_SESSION=1000
CONTEXT_STRATEGY=truncate          # truncate: drop oldest turns | summarize: fold them into a running summary
CONTEXT_MAX_TOKENS=0               # 0 = engine max_model_len
CONTEXT_RESERVE_TOKENS=64
CONTEXT_TRIM_TARGET_RATIO=0.7      # trim to 70% of the budget so later turns keep prefix-cache hits
CONTEXT_CHARS_PER_TOKEN=3.0        # initial estimate; calibrated per session from real usage
SUMMARY_MAX_TOKENS=256

# -------------------------------------------------------------------- tools
TOOLS_MODULES=app.tools.builtin    # comma-separated modules registering server-side tools
TOOL_TIMEOUT_S=10
MAX_TOOL_ROUNDS=4

# ---------------------------------------------------------------- websocket
WS_MAX_MESSAGE_BYTES=262144
WS_SEND_QUEUE_SIZE=1024
WS_SEND_TIMEOUT_S=10               # a client that stops reading this long is disconnected
WS_IDLE_TIMEOUT_S=600
WS_PING_INTERVAL_S=20
WS_BARGE_IN=cancel                 # cancel: a new response.create cancels the running one | reject
SEGMENT_MIN_CHARS=8                # sentence segments for TTS (response.text.segment)
SEGMENT_MAX_CHARS=220

# ------------------------------------------------------------ observability
METRICS_ENABLED=true
