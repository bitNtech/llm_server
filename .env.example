# =====================================================================================================
# AICA LLM server configuration. Copy to .env for local use; real environment variables override it.
# Every variable is validated at startup (./run.sh check prints the effective setup).
# =====================================================================================================

# ------------------------------------------------------------------------------------------- server
APP_ENV=development                 # production: requires the secrets below, JSON logs, /docs off
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=auto                     # auto (json in production) | json | text
ACCESS_LOG=false
SHUTDOWN_GRACE_S=20                 # SIGTERM: in-flight answers get this long to finish
FORWARDED_ALLOW_IPS=127.0.0.1       # proxies trusted for X-Forwarded-For ("*" behind a cloud load balancer)
CORS_ALLOW_ORIGINS=                 # comma-separated browser origins (never "*" in production)
# INSTANCE_ID=                      # lease owner id; default <hostname>-<random>

# ------------------------------------------------------------------------------------- google cloud
GCP_PROJECT_ID=                     # project for Vertex AI (and Firestore unless FIRESTORE_PROJECT_ID is set)
# Credentials (pick one): GOOGLE_APPLICATION_CREDENTIALS=/path/key.json | GCP_CREDENTIALS_JSON='{...}' or its
# base64 | workload identity / metadata server on GCP | `gcloud auth application-default login` on a laptop.
# GCP_CREDENTIALS_JSON=
# Required IAM roles for the service account: roles/aiplatform.user, roles/datastore.user

# ------------------------------------------------------------------------------------------ vertex ai
# Default: Gemini 3.5 Flash - fastest model with a 1,048,576-token window that this project can use
# (measured TTFT ~420-580 ms from India via asia-south1). Locations are tried in order on 429/5xx/timeouts.
VERTEX_MODEL=google/gemini-3.5-flash
VERTEX_FALLBACK_MODELS=google/gemini-3.1-flash-lite   # used when every location of the main model fails
VERTEX_ALLOWED_MODELS=              # extra models agents/clients may select, e.g. google/gemini-3.5-flash-lite
VERTEX_LOCATIONS=asia-south1,global
VERTEX_REASONING_EFFORT=minimal     # minimal = fastest first token for voice
VERTEX_TOOL_FOLLOWUP_REASONING_EFFORT=low   # 'minimal' intermittently returns empty answers after tool results
VERTEX_CONTEXT_WINDOW=1048576
VERTEX_FIRST_TOKEN_TIMEOUT_S=12     # total budget for retries/failover before the first token
VERTEX_STREAM_IDLE_TIMEOUT_S=20
VERTEX_MAX_ATTEMPTS=4
VERTEX_KEEPALIVE_INTERVAL_S=25      # keep TLS connections warm while idle (0 = off)
VERTEX_CIRCUIT_FAILURES=5
VERTEX_CIRCUIT_RESET_S=20
VERTEX_STARTUP_PROBE=true           # 1-token request at start: validates access, warms the connection
# VERTEX_ENDPOINT_TEMPLATE=         # e.g. a Private Service Connect host: https://psc.example/v1/projects/{project}/locations/{location}/endpoints/openapi

# ------------------------------------------------------------------------------------------ firestore
FIRESTORE_DATABASE=llm_server       # named Firestore (native mode) database
FIRESTORE_PROJECT_ID=               # default: GCP_PROJECT_ID (or the project in FIRESTORE_CREDENTIALS_JSON)
# FIRESTORE_CREDENTIALS_JSON=        # Firestore in another project/account: its service-account JSON or base64
#                                   # (role roles/datastore.user). Default: the Vertex credentials above.
FIRESTORE_COLLECTION_PREFIX=        # namespace root collections (e.g. staging_) to share one database
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8686   # local development: ./run.sh dev starts an emulator

# ------------------------------------------------------------------------------------------- security
ADMIN_API_KEYS=                     # platform admin keys (comma-separated, >= 24 chars): manage tenants
SECRETS_ENCRYPTION_KEY=             # Fernet key(s), newest first: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
REALTIME_TOKEN_SECRET=              # >= 32 chars: python -c 'import secrets; print(secrets.token_urlsafe(48))'
REALTIME_TOKEN_MAX_TTL_S=3600
RATE_LIMIT_PER_MINUTE=1200          # per API key (tenants can override); 0 = off
API_KEY_CACHE_TTL_S=30              # revocations reach other instances within this time
ALLOW_PRIVATE_NETWORK_TARGETS=false # let HTTP tools / MCP / webhooks call private IPs (development only)
ALLOWED_TARGET_HOSTS=               # hosts exempt from the private-network check
WS_QUERY_API_KEY=false              # accept ?api_key= on the WebSocket (prefer realtime tokens)
MAX_REQUEST_BODY_BYTES=2097152

# ---------------------------------------------------------------------------------- inference defaults
DEFAULT_INSTRUCTIONS=You are a helpful, concise voice assistant. Reply in one or two short sentences.
DEFAULT_MAX_TOKENS=512
MAX_TOKENS_LIMIT=8192
DEFAULT_TEMPERATURE=                # empty = model default
MAX_INPUT_CHARS=64000

# -------------------------------------------------------------------------------- concurrency / timing
MAX_CONCURRENT_GENERATIONS=256      # per instance; protects Vertex quota and cost
MAX_QUEUED_GENERATIONS=1024
QUEUE_TIMEOUT_S=2                   # then 429 so the agent can play a fallback line
GENERATION_TIMEOUT_S=120

# ------------------------------------------------------------------------------- sessions and context
SESSION_CACHE_TTL_S=180             # idle sessions leave memory and free their lease (they stay in Firestore)
SESSION_LEASE_S=60                  # one instance owns a live session; another can take over after this
MAX_MESSAGES_PER_SESSION=5000
CONTEXT_STRATEGY=truncate           # truncate | summarize
CONTEXT_MAX_TOKENS=65536            # prompt budget per turn (<= VERTEX_CONTEXT_WINDOW); smaller = faster/cheaper
CONTEXT_TRIM_TARGET_RATIO=0.7

# -------------------------------------------------------------------------------------------- tools
TOOL_TIMEOUT_S=10
MAX_TOOL_ROUNDS=8
MAX_HANDOFFS_PER_TURN=3
TOOL_OUTPUT_MAX_CHARS=20000
MCP_CONNECT_TIMEOUT_S=10
MCP_CALL_TIMEOUT_S=30
MCP_TOOLS_CACHE_TTL_S=300

# --------------------------------------------------------------------------------------- executions
EXECUTION_WORKERS=8                 # 0 = this instance never runs async executions
EXECUTION_LEASE_S=60
EXECUTION_MAX_ATTEMPTS=3
EXECUTION_TIMEOUT_S=900
WEBHOOK_MAX_ATTEMPTS=6

# ---------------------------------------------------------------------------------------- websocket
WS_IDLE_TIMEOUT_S=900
WS_PING_INTERVAL_S=20
BARGE_IN=cancel                     # cancel: a new response.create cancels the running one | reject
SEGMENT_MIN_CHARS=8
SEGMENT_MAX_CHARS=220

# ------------------------------------------------------------------------------------ observability
METRICS_ENABLED=true
METRICS_REQUIRE_AUTH=false
OTEL_EXPORTER_OTLP_ENDPOINT=        # e.g. http://otel-collector:4318 (traces off when empty)
OTEL_SERVICE_NAME=aica-llm-server
OTEL_SAMPLE_RATIO=1.0
